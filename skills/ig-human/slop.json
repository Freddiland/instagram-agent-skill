  "structures": [
    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno es (?:solo|sólo|solamente|únicamente) [^.!?\\n]{2,60}[,.;] es\\b",
      "name": "«No es solo X, es Y»",
      "fix": "Di lo único que quieres decir. Borra la mitad del montaje."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata (?:solo |sólo |solamente )?de [^.!?\\n]{2,60}[,.;]\\s*(?:se trata de|sino de)\\b",
      "name": "«No se trata de X. Se trata de Y»",
      "fix": "Empieza por Y. El giro es lo que delata."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno (?:solo|sólo|solamente|únicamente)\\b[^.!?\\n]{2,80}\\bsino (?:que )?también\\b",
      "name": "«No solo X, sino también Y»",
      "fix": "Divide en dos frases o quita la mitad más floja."
    },
    {
      "id": "el-resultado",
      "regex": "(?im)^\\s*¿?(?:el resultado|lo mejor|la clave|el truco|lo peor|la trampa|el problema|la respuesta)\\?\\s*$",
      "name": "Pregunta retórica de una línea («¿El resultado?»)",
      "fix": "Responde en la misma frase en vez de montar una revelación."
    },
    {
      "id": "esto-es-lo-que",
      "regex": "(?i)\\b(?:esto es lo que|esto fue lo que|te cuento lo que|os cuento lo que) (?:aprendí|aprendimos|descubrí)\\b|\\blo que aprendí\\s*:",
      "name": "«Esto es lo que aprendí»",
      "fix": "Di la lección. Sáltate el anuncio."
    },
    {
      "id": "triada",
      "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
      "name": "Tríada de tres elementos",
      "fix": "Dos elementos o cuatro. Tres es el ritmo por defecto de la máquina."
    },
    {
      "id": "cohete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de cohete / fuego / bombilla / destellos / diana",
      "fix": "Un emoji como mucho, y que no sea uno de estos cinco."
    },
    {
      "id": "muro-hashtags",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro de hashtags (5 o más)",
      "fix": "Tres hashtags. Instagram limita a cinco y el muro ya no da alcance."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial)\\b|\\bcomo modelo de lenguaje\\b",
      "name": "La IA hablando de sí misma",
      "fix": "Borra la frase."
    },
    {
      "id": "en-resumen",
      "regex": "(?im)^\\s*(?:en resumen|en conclusión|para concluir|en definitiva|para resumir)\\b",
      "name": "Apertura de cierre de redacción («En resumen»)",
      "fix": "Un post no necesita párrafo de conclusión."
    },
    {
      "id": "cebo-interaccion",
      "regex": "(?im)¿?\\b(?:estás de acuerdo|qué opináis|qué opinas|tú qué opinas|me equivoco|quién más)\\b[^?\\n]{0,30}\\?\\s*$",
      "name": "Cebo de interacción reflejo",
      "fix": "Haz una pregunta que solo tú podrías hacer, sobre lo concreto que acabas de contar."
    },
    {
      "id": "deja-scroll",
      "regex": "(?im)^\\s*(?:deja de (?:hacer )?scroll|para de (?:hacer )?scroll|no hagas scroll|no pases de largo|espera,? no (?:pases|hagas scroll))\\b",
      "name": "Apertura «Deja de hacer scroll»",
      "fix": "Lo que frena el scroll tiene que ser la afirmación. Pedir atención delata que no te la has ganado."
    },
    {
      "id": "en-este-video",
      "regex": "(?i)\\b(?:en (?:este|el) (?:vídeo|video|reel|post)(?: de hoy)?|hoy (?:te|os) voy a (?:enseñar|contar|mostrar)|(?:te|os) voy a (?:enseñar|mostrar) cómo)\\b",
      "name": "Preámbulo de vídeo («En este vídeo te voy a enseñar»)",
      "fix": "Bórralo y empieza por lo que prometes. Los dos primeros segundos deciden el reel entero."
    },
    {
      "id": "viñetas-emoji",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista con emojis como viñetas",
      "fix": "Usa un guion o un salto de línea. Las viñetas con emoji son lo que más huele a plantilla en un texto."
    },
    {
      "id": "mayusculas",
      "regex": "\\b[A-ZÁÉÍÓÚÑÜ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑÜ]{3,}\\b){2,}",
      "name": "Tres o más palabras seguidas en mayúsculas",
      "fix": "Las mayúsculas son el volumen, no el subrayador. Una palabra como mucho."
    },
    {
      "id": "cebo-seguir",
      "regex": "(?i)\\b(?:sígueme para más|sigueme para mas|dale a seguir|etiqueta a (?:alguien|un amigo|una amiga)|menciona a (?:alguien|un amigo|una amiga)|dale doble tap|doble tap si|comparte esto si|comenta abajo si|dale like si|dale me gusta si)\\b",
      "name": "Cebo reflejo de seguir o etiquetar",
      "fix": "Pide la única acción que este post se gana. La petición genérica enseña a ignorar todas."
    },
    {
      "id": "titulo-ingles",
      "regex": "(?m)^\\s*(?:[A-ZÁÉÍÓÚÑ][\\wáéíóúñü]+\\s+){3,}[A-ZÁÉÍÓÚÑ][\\wáéíóúñü]+[:.!?]?\\s*$",
      "name": "Mayúscula en cada palabra del título (calco del inglés)",
      "fix": "En español solo va en mayúscula la primera palabra y los nombres propios."
    },
    {
      "id": "conector-inicio",
      "regex": "(?:^|(?<=[.!?]\\s))(?:Además|Asimismo|Adicionalmente|Por otro lado|Por otra parte|En este sentido|De igual manera|Del mismo modo),",
      "name": "Conector de redacción al inicio de frase",
      "fix": "Quítalo o une las frases. Así no habla nadie en un reel."
    }
